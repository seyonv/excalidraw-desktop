{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sketchshelf",
  "version": "1.0.0",
  "identifier": "dev.seyon.sketchshelf",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sketchshelf",
        "width": 1000,
        "height": 700,
        "create": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-eval' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost data: blob:",
        "worker-src": "'self' data: blob:",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": null,
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "excalidraw"
        ],
        "name": "Excalidraw Drawing",
        "description": "Excalidraw Drawing File",
        "contentTypes": [
          "dev.seyon.sketchshelf.drawing"
        ],
        "exportedType": {
          "identifier": "dev.seyon.sketchshelf.drawing",
          "conformsTo": [
            "public.json"
          ]
        }
      }
    ],
    "copyright": "\u00a9 2026 Seyon Vasantharajan. Built on the open-source Excalidraw editor (MIT License); not affiliated with Excalidraw.",
    "macOS": {
      "bundleVersion": "4"
    }
  }
}
