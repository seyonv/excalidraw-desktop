{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "excalidraw-desktop",
  "version": "0.1.0",
  "identifier": "com.excalidraw.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Excalidraw Desktop",
        "width": 1000,
        "height": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "excalidraw"
        ],
        "name": "Excalidraw Drawing",
        "description": "Excalidraw Drawing File",
        "contentTypes": [
          "com.excalidraw.desktop.drawing"
        ],
        "exportedType": {
          "identifier": "com.excalidraw.desktop.drawing",
          "conformsTo": [
            "public.json"
          ]
        }
      }
    ]
  }
}
